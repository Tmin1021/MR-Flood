# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

RWT_Cache/

# AI/agent-only local artifacts
**/.agents/
/.codex/
/.cursor/
/.claude/
/AGENTS.md
/CLAUDE.md
/SpatialPlacementSystem_Editor_DebugCube_Test_Setup.txt
/Assets/Editor/ChatGPT Image Aug 20, 2026, 01_18_30 PM.png*

# Local licensed Asset Store sources. Contributors must import their own
# licensed copies; project-owned generated outputs are retained separately.
/Assets/!GET_MORE_ASSETS_FOR_FREE/
/Assets/!GET_MORE_ASSETS_FOR_FREE.meta
/Assets/BrokenVector/
/Assets/BrokenVector.meta
/Assets/Building Generator/
/Assets/Building Generator.meta
/Assets/BuildR2/
/Assets/BuildR2.meta
/Assets/City Pack/
/Assets/City Pack.meta
/Assets/EasyRoads3D/
/Assets/EasyRoads3D.meta
/Assets/EasyRoads3D scenes/
/Assets/EasyRoads3D scenes.meta
/Assets/Gizmos/
/Assets/Gizmos.meta
/Assets/Real World Terrain/
/Assets/Real World Terrain.meta
/Assets/SCI-FI UI Pack Pro/
/Assets/SCI-FI UI Pack Pro.meta
/Assets/SUIMONO - WATER SYSTEM 2/
/Assets/SUIMONO - WATER SYSTEM 2.meta

# Large local terrain-generation archives not referenced by the committed
# runtime scene. The baked runtime city remains under Assets/Generated.
/Assets/RWT_Result/Main Use/
/Assets/RWT_Result/Main Use.meta
/Assets/RWT_Result/2026-05-03 00-09.meta
/Assets/RWT_Result/2026-05-03 00-13.meta
/Assets/RWT_Result/2026-05-03 00-22.meta
/Assets/Export.meta

# Unused/generated Meta XR imports and settings (the project targets MRTK2).
/Assets/Oculus/
/Assets/Oculus.meta
/Assets/Samples/Meta XR Interaction*SDK/
/Assets/Samples/Meta XR Interaction*SDK.meta
/Assets/Resources/ImmersiveDebuggerSettings.asset*
/Assets/Resources/InputActions.asset*
/Assets/Resources/MetaXR*.asset*
/Assets/Resources/OVR*.asset*
/Assets/Resources/OculusRuntimeSettings.asset*

# Local UWP signing material must never be committed.
/Assets/WSATestCertificate.pfx
/Assets/WSATestCertificate.pfx.meta
